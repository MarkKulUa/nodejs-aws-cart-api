APP_PORT=4000

### These variables are needed to make script for getting access_token works
AUTH_USERNAME=yourGithubLogin ### It should be your github username
AUTH_PASSWORD=TEST_PASSWORD
APP_URL=http://localhost:4000
###

### PostgreSQL (RDS) connection — used by the lambda and the CDK stack
DB_HOST=your-cart-db.xxxxxxxx.eu-west-1.rds.amazonaws.com
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=cart
DB_SSL=true
